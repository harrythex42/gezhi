# 复制为 .env 后填写。最少只需要一个阿里云百炼的 Key。
# 申请：https://bailian.console.aliyun.com/ → API-KEY（新用户有免费额度）
DASHSCOPE_API_KEY=

# ---- 大模型（任意 OpenAI 兼容接口）----
# 默认用百炼的通义千问，Key 同上，可不填 LLM_API_KEY
LLM_MODEL=qwen-plus
# 换成 DeepSeek 的例子：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
# 不想花钱、只测链路：LLM_PROVIDER=echo

# ---- 语音合成 ----
# 留空 = 有百炼 Key 就用 CosyVoice，否则用免费的 edge-tts
# TTS_PROVIDER=edge
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# COSYVOICE_VOICE=longxiaochun_v2

# ---- 服务器 ----
PORT=8000
# 设备连不上时手动指定 Mac 的局域网 IP
# PUBLIC_HOST=192.168.1.23
# 设了以后设备必须带这个 token 才能连（OTA 会自动下发给设备）
# SERVER_TOKEN=

# SYSTEM_PROMPT=你是小智……
